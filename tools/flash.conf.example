# Copy to flash.conf in the main worktree (not versioned) and adapt.
# Bash syntax, sourced by tools/flash.sh: keep only these variable assignments.
# Command-line arguments take precedence. Another path can be given with SR_FLASH_CONF.

# OTA_HOST: default target of `tools/flash.sh --ota` (overridden by --ota HOST|URL).
#   - IP or hostname, optional :port  -> http://HOST/update and http://HOST/ParaFixe
#   - full URL http[s]://name[:port][/prefix] -> <URL>/update, e.g. through a reverse proxy
OTA_HOST=192.168.1.50

# OTA_COOKIE: optional cookie sent with every OTA request (/ParaFixe and /update), as
#   NAME=ENVVAR. NAME is the cookie name, ENVVAR the name of an exported environment
#   variable holding its value (e.g. set in ~/.zshenv). The value itself never goes in this
#   file, in the logs, or on the curl command line. Overridden by --cookie NAME=ENVVAR.
#OTA_COOKIE=auth_token=PROXY_COOKIE

# OTA_COOKIE_DOMAIN: required when a cookie is set. The cookie is only sent over https://
#   to this domain or one of its subdomains, redirects are never followed; any other
#   target (http://, other host, look-alike names) is refused before the first request.
#   Overridden by --cookie-domain DOMAIN.
#OTA_COOKIE_DOMAIN=example.org

# SERIAL_PORT: USB serial port for `tools/flash.sh --serial` (overridden by --serial PORT).
#   Optional; default: the only USB serial port found (cu.usbserial*, SLAB*, wchusbserial*,
#   usbmodem*, ttyUSB*, ttyACM*).
#SERIAL_PORT=/dev/cu.usbserial-0001
